// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VIEWER
}

enum HomeworkStatus {
  COMPLETED
  NOT_COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  homeworks     Homework[]
  tests         Test[]
  remarks       StudentRemark[]
}

model Student {
  id            String    @id @default(cuid())
  fullName      String
  rollNumber    String
  className     String
  section       String    @default("A")
  gender        String?
  dateOfBirth   DateTime?
  guardianName  String?
  guardianPhone String?
  address       String?
  admissionDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  homeworkRecords HomeworkRecord[]
  testResults     TestResult[]
  remarks         StudentRemark[]

  @@unique([rollNumber, className, section])
}

model Homework {
  id           String   @id @default(cuid())
  title        String
  subject      String
  description  String?
  className    String
  section      String
  assignedDate DateTime
  dueDate      DateTime
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy       User             @relation(fields: [createdById], references: [id])
  homeworkRecords HomeworkRecord[]
}

model HomeworkRecord {
  id         String         @id @default(cuid())
  studentId  String
  homeworkId String
  status     HomeworkStatus @default(NOT_COMPLETED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@unique([studentId, homeworkId])
}

model Test {
  id          String   @id @default(cuid())
  name        String
  subject     String
  className   String
  section     String
  testDate    DateTime
  fullMarks   Int
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User         @relation(fields: [createdById], references: [id])
  testResults TestResult[]
}

model TestResult {
  id            String   @id @default(cuid())
  testId        String
  studentId     String
  obtainedMarks Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
}

model StudentRemark {
  id          String   @id @default(cuid())
  studentId   String
  remark      String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
}
